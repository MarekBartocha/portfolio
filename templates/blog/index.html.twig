{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="text-center">{{ 'topic.page_title'|trans }}</h1><br>

    <ul class="list-group">
        {% for topic in topics %}
            {% if topic.public %}

                {% set topicName = {
                    'pl': topic.namePl,
                    'en': topic.nameEn,
                    'de': topic.nameDe
                }[app.request.locale] ?? topic.namePl %}

                <li style="background-color:#949b8f;"
                    class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <a class="text-dark fw-bold text-decoration-none"
                           href="{{ path('public_topic_show', {
                               slug: topic.slug,
                               _locale: app.request.locale
                           }) }}">
                            {{ topicName }}
                        </a>
                    </div>
                </li>

            {% endif %}
        {% else %}
            <li class="list-group-item">
                {{ 'topic.no_topics'|trans }}
            </li>
        {% endfor %}
    </ul>
{% endblock %}