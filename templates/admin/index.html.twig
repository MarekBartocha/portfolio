{% extends 'base.html.twig' %}

{% block body %}


   {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
   {% endfor %}

   {% for message in app.flashes('error') %}
      <div class="alert alert-danger">{{ message }}</div>
   {% endfor %}

   {{ form_start(form) }}

      <div class="container mt-4"><p>
         <div class="d-flex justify-content-center">
               <div class="d-flex flex-column gap-3" style="width: 100%; max-width: 500px;">
               <p class="text-center">{{ 'topic.new'|trans }}</p>

                  <div>
                     {{ form_label(form.name_pl) }}
                     {{ form_widget(form.name_pl, {
                           'attr': {
                              'class': 'form-control'
                           }
                     }) }}
                     {{ form_errors(form.name_pl) }}
                  </div>

                  <div>
                     {{ form_label(form.name_en) }}
                     {{ form_widget(form.name_en, {
                           'attr': {
                              'class': 'form-control'
                           }
                     }) }}
                     {{ form_errors(form.name_en) }}
                  </div>

                  <div>
                     {{ form_label(form.name_de) }}
                     {{ form_widget(form.name_de, {
                           'attr': {
                              'class': 'form-control'
                           }
                     }) }}
                     {{ form_errors(form.name_de) }}
                  </div>

                  <div class="form-check d-flex align-items-center gap-2 mb-0">
                     {{ form_widget(form.public, {
                           'attr': {'class': 'form-check-input'}
                     }) }}
                     {{ form_label(form.public, null, {
                           'label_attr': {'class': 'form-check-label mb-0'}
                     }) }}
                  </div>

                  <button type="submit" class="btn btn-primary">
                     {{ 'button.save'|trans }}
                  </button>

               </div>
         </div>
      </div>

   {{ form_end(form) }}



   <center>
      <br>
      <h2 class="mt-4">{{ 'topic.list.title'|trans }}</h2>
   </center>

   <ul class="list-group">
   {% for topic in topics %}
      <li style="background-color:#949b8f;"
         class="list-group-item d-flex justify-content-between align-items-center">

         <div>
               <a class="text-dark fw-bold text-decoration-none"
                  href="{{ path('topic_show', {
                     slug: topic.slug,
                     _locale: app.request.locale
                  }) }}">
                  {{ topic.getName(current_locale) }}
               </a>
         </div>

         <div class="d-flex align-items-center gap-2">
            {% if topic.public %}
               <p class="mb-0 text-success">{{ 'Public'|trans }}</p>
            {% else %}
               <p class="mb-0 text-muted">{{ 'Private'|trans }}</p>
            {% endif %}

               <a href="{{ path('topic_edit', {
                  id: topic.id,
                  _locale: app.request.locale
               }) }}" class="btn btn-sm btn-outline-primary">
                  {{ 'button.edit'|trans }}
               </a>

               <form method="post"
                     action="{{ path('topic_delete', {
                        id: topic.id,
                        _locale: app.request.locale
                     }) }}"
                     style="display:inline;"
                     onsubmit="return confirm('{{ 'topic.delete.confirm'|trans|e('js') }}');">

                  <input type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ topic.id) }}">

                  <button class="btn btn-sm btn-outline-danger">
                     {{ 'button.delete'|trans }}
                  </button>
               </form>
         </div>
      </li>
   {% else %}
      <li class="list-group-item">{{ 'topic.list.empty'|trans }}</li>
   {% endfor %}
   </ul>

{% endblock %}
