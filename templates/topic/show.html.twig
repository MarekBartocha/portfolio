{% extends 'base.html.twig' %}

{% block body %}

   {% set locale = app.request.locale %}

   {% set topicName = {
      'pl': topic.namePl,
      'en': topic.nameEn,
      'de': topic.nameDe
   }[locale] ?? topic.namePl %}

   <center><h1>{{ topicName }}</h1></center>

   {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
   {% endfor %}

   <div class="d-flex justify-content-center mt-4">
      <div class="d-flex gap-2">
         <a class="btn btn-primary" href="{{ path('blog_new', {
            '_locale': locale,
            'slug': topic.slug
         }) }}">
            {{ 'blog.add'|trans }}
         </a>
      </div>
   </div>

   <a href="{{ path('admin_index', {'_locale': locale}) }}"
      class="btn btn-secondary mt-3">
      Powrót
   </a>

   <br>

   {% if renderedBlogs is not empty %}

      {% for entry in renderedBlogs %}

         {% set blogTitle = {
            'pl': entry.blog.titlePl,
            'en': entry.blog.titleEn,
            'de': entry.blog.titleDe
         }[locale] ?? entry.blog.titlePl %}

         <div style="background-color:#949b8f; color: black"
              class="blog-entry border border-1 rounded-2 m-3 p-2">

            <h3 class="text-center">{{ blogTitle }}</h3>

            <div class="blog-content">
               {{ entry.renderedContent|raw|replace({
                  '[code]': '<pre><code>',
                  '[/code]': '</code></pre>'
               })|raw }}
            </div>

            <div class="d-flex align-items-center gap-2">

               <a href="{{ path('blog_edit', {
                  '_locale': locale,
                  'id': entry.blog.id,
                  'slug_topic': topic.slug
               }) }}"
                  class="btn btn-sm btn-outline-primary me-2">
                  {{ 'button.edit'|trans }}
               </a>

               <form method="post"
                     action="{{ path('blog_delete', {
                        'id': entry.blog.id,
                        '_locale': locale,
                        'slug': topic.slug
                     }) }}"
                     style="display:inline;"
                     onsubmit="return confirm('{{ 'blog.delete.confirm'|trans|e('js') }}');">

                  <input type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ entry.blog.id) }}">

                  <button class="btn btn-sm btn-outline-danger">
                     {{ 'button.delete'|trans }}
                  </button>
               </form>

               {% if entry.blog.public %}
                  <p class="mb-0 text-success">{{ 'Public'|trans }}</p>
               {% else %}
                  <p class="mb-0 text-muted">{{ 'Private'|trans }}</p>
               {% endif %}

            </div>
         </div>

      {% endfor %}

   {% else %}

      <p>{{ 'topic.no_posts'|trans }}</p>

   {% endif %}

{% endblock %}