{% extends 'base.html.twig' %}

{% block body %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="container mt-4">
        <h2>{{ 'topic.edit.title'|trans }}</h2>

        {{ form_start(form, {'attr': {'class': 'd-flex flex-column gap-3'}}) }}

            <div>
                {{ form_label(form.name_pl, 'topic.form.name_pl'|trans) }}
                {{ form_widget(form.name_pl, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'topic.form.placeholder_pl'|trans
                    }
                }) }}
                {{ form_errors(form.name_pl) }}
            </div>

            <div>
                {{ form_label(form.name_en, 'topic.form.name_en'|trans) }}
                {{ form_widget(form.name_en, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'topic.form.placeholder_en'|trans
                    }
                }) }}
                {{ form_errors(form.name_en) }}
            </div>

            <div>
                {{ form_label(form.name_de, 'topic.form.name_de'|trans) }}
                {{ form_widget(form.name_de, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'topic.form.placeholder_de'|trans
                    }
                }) }}
                {{ form_errors(form.name_de) }}
            </div>

            <div class="form-check d-flex align-items-center gap-2 mb-0">
                {{ form_widget(form.public, {
                    'attr': {'class': 'form-check-input'}
                }) }}

                {{ form_label(form.public, null, {
                    'label_attr': {'class': 'form-check-label mb-0'}
                }) }}
            </div>

            <button type="submit" class="btn btn-primary">
                {{ 'button.save'|trans }}
            </button>

        {{ form_end(form) }}

        <a href="{{ path('admin_index', {
            '_locale': app.request.locale
        }) }}" class="btn btn-secondary mt-3">
            {{ 'button.back'|trans }}
        </a>
    </div>

{% endblock %}